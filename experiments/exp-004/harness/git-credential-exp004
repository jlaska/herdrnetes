#!/usr/bin/env python3
"""EXP-004 Git credential helper: asks the issuer for a short-lived token per operation.

Configure (global): credential.helper=/path/to/git-credential-exp004, credential.useHttpPath=true
Environment:
  EXP004_ISSUER_SOCK   issuer Unix socket
  EXP004_CLIENT_FILE   JSON {"client": id, "secret": s}; must be mode 0600 (refused otherwise)
  EXP004_HOST          host[:port] this helper may answer for
  EXP004_ACCESS        "write" asks for write, anything else read. This is a convenience, NOT a
                       security control: the issuer policy decides what is granted.
get    -> username=x-access-token, password=<token>, password_expiry_utc=<unix>
          On any failure: concise message on stderr (no secrets) and quit=1 so Git neither prompts
          nor tries other helpers.
store  -> ignored (nothing cached or written)
erase  -> best-effort revoke_own of the rejected/used token
Nothing is written to disk and no secret appears in argv.
"""

import json
import os
import socket
import stat
import sys


class Fail(Exception):
    pass


def ask(req):
    sock = os.environ.get("EXP004_ISSUER_SOCK", "")
    try:
        with socket.socket(socket.AF_UNIX) as s:
            s.settimeout(3)
            s.connect(sock)
            s.sendall((json.dumps(req) + "\n").encode())
            return json.loads(s.makefile().readline())
    except (OSError, ValueError) as e:
        raise Fail(f"issuer unavailable at {sock}: {e.strerror or type(e).__name__}".lower())


def client():
    path = os.environ.get("EXP004_CLIENT_FILE", "")
    try:
        if os.stat(path).st_mode & (stat.S_IRWXG | stat.S_IRWXO):
            raise Fail(f"{path} is group/world accessible; chmod 600")
        c = json.load(open(path))
        return {"client": c["client"], "secret": c["secret"]}
    except (OSError, ValueError, KeyError):
        raise Fail(f"cannot read client credentials from EXP004_CLIENT_FILE={path!r}")


def attrs():
    return dict(l.rstrip("\n").split("=", 1) for l in sys.stdin if "=" in l)


def get(a):
    if a.get("protocol") not in ("http", "https"):
        raise Fail("only http(s) is supported")
    if a.get("host") != os.environ.get("EXP004_HOST"):
        raise Fail(f"host {a.get('host')!r} is not this helper's EXP004_HOST")
    path = a.get("path")
    if not path:
        raise Fail("no path from Git; set credential.useHttpPath=true")
    repo = path.removesuffix(".git").strip("/")
    access = "write" if os.environ.get("EXP004_ACCESS") == "write" else "read"
    r = ask({"op": "token", **client(), "repo": repo, "access": access})
    if "error" in r:
        raise Fail(f"issuer refused: {r['error']}")
    print(f"username=x-access-token\npassword={r['token']}\npassword_expiry_utc={r['expires_at']}")


def erase(a):
    if a.get("password"):
        try:
            ask({"op": "revoke_own", **client(), "token": a["password"]})
        except Fail:
            pass  # best effort


def main():
    op = sys.argv[1] if len(sys.argv) > 1 else ""
    a = attrs()
    if op == "get":
        try:
            get(a)
        except Fail as e:
            print(f"exp004: {e}", file=sys.stderr)
            print("quit=1")
    elif op == "erase":
        erase(a)


if __name__ == "__main__":
    main()
