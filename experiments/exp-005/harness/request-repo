#!/usr/bin/env python3
"""request-repo: lazily hydrate a Git repository into the shared workspace PVC (EXP-005 M1).

usage: request-repo [--timeout SEC] [--depth N] [--filter SPEC] [--branch B] <repository-id> <source>

stdout: one JSON object. stderr: diagnostics.
Exit codes: 0 ready, 2 usage/invalid id/disallowed source, 3 source mismatch,
4 conflict (unmanaged path at target), 5 clone failed, 6 lock timeout, 7 environment error.

Environment:
  WORKSPACE_ROOT               default /workspace. Repo lives at $WORKSPACE_ROOT/<id>;
                               metadata at $WORKSPACE_ROOT/.herdr-repos/{locks,staging,state}.
  REQUEST_REPO_TIMEOUT         lock-wait and clone timeout in seconds (default 600).
  REQUEST_REPO_ALLOW_SCHEMES   comma list; PoC supports "file" (file:// URLs and absolute local
                               paths only). Default "file".
  REQUEST_REPO_TEST_PAUSE_AFTER_CLONE=<seconds>
                               TEST-ONLY: sleep after a successful clone, before promotion, so
                               tests can SIGKILL the process. Never set in normal use.
  GIT_TERMINAL_PROMPT          forced to 0 for the clone.

Existing repositories are never modified: the already-ready path runs only read-only
`git rev-parse` commands (GIT_OPTIONAL_LOCKS=0), never fetch/reset/checkout/clean/status.
"""
import argparse, ctypes, errno, fcntl, json, os, random, re, shutil, signal, subprocess, sys, time

ID_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,62}$")
RENAME_NOREPLACE = 1


class Fail(Exception):
    def __init__(self, code, status, msg):
        super().__init__(msg)
        self.code, self.status, self.msg = code, status, msg


def log(msg):
    print(f"request-repo[{os.getpid()}]: {msg}", file=sys.stderr, flush=True)


def git(args, cwd=None, check=False, timeout=60):
    env = dict(os.environ, GIT_OPTIONAL_LOCKS="0", GIT_TERMINAL_PROMPT="0")
    return subprocess.run(["git"] + args, cwd=cwd, env=env, capture_output=True, text=True,
                          timeout=timeout, check=check)


def normalize_source(src, allowed):
    if "file" not in allowed:
        raise Fail(2, "invalid", "no supported scheme allowed (PoC supports only 'file')")
    if src.startswith("file://"):
        path = src[len("file://"):]
        if not path.startswith("/"):
            raise Fail(2, "invalid", "file:// source must have an absolute path (no host)")
    elif src.startswith("/"):
        path = src
    else:
        raise Fail(2, "invalid", f"source scheme not allowed: {src!r} (only file:// or absolute path)")
    return "file://" + os.path.realpath(path)


def fsync_dir(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def write_json_atomic(path, obj):
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(obj, f, indent=1, sort_keys=True)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)
    fsync_dir(os.path.dirname(path))


def read_state(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (FileNotFoundError, ValueError):
        return None


def acquire_lock(path, timeout):
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    deadline = time.monotonic() + timeout
    waited = False
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd, waited
        except OSError as e:
            if e.errno not in (errno.EWOULDBLOCK, errno.EAGAIN, errno.EACCES):
                raise
        waited = True
        if time.monotonic() >= deadline:
            os.close(fd)
            raise Fail(6, "lock-timeout", f"could not acquire {path} within {timeout}s")
        time.sleep(0.1)


def valid_repo(target):
    """True if target is itself a git work tree root (read-only checks)."""
    try:
        if git(["rev-parse", "--git-dir"], cwd=target).returncode != 0:
            return False
        top = git(["rev-parse", "--show-toplevel"], cwd=target)
        return top.returncode == 0 and os.path.realpath(top.stdout.strip()) == os.path.realpath(target)
    except (OSError, subprocess.SubprocessError):
        return False


def repo_info(target):
    r = git(["rev-parse", "HEAD"], cwd=target)
    head = r.stdout.strip() if r.returncode == 0 else None
    sh = git(["rev-parse", "--is-shallow-repository"], cwd=target).stdout.strip() == "true"
    pr = git(["config", "--get", "remote.origin.promisor"], cwd=target).stdout.strip() == "true"
    return head, sh, pr


def origin_url(target):
    r = git(["config", "--get", "remote.origin.url"], cwd=target)
    return r.stdout.strip() if r.returncode == 0 else None


def die_with_parent():
    PR_SET_PDEATHSIG = 1
    ctypes.CDLL(None, use_errno=True).prctl(PR_SET_PDEATHSIG, signal.SIGKILL)


def promote(staging, target, root):
    """Atomically move staging to target without replacing. Returns promotion method."""
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        fn = libc.renameat2
        fn.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
        fn.restype = ctypes.c_int
        AT_FDCWD = -100
        if fn(AT_FDCWD, os.fsencode(staging), AT_FDCWD, os.fsencode(target), RENAME_NOREPLACE) == 0:
            fsync_dir(root)
            return "renameat2"
        err = ctypes.get_errno()
        if err == errno.EEXIST:
            raise Fail(4, "conflict", f"target appeared during promotion: {target}")
        if err not in (errno.ENOSYS, errno.EINVAL):
            raise Fail(7, "error", f"renameat2 failed: {os.strerror(err)}")
    except AttributeError:
        pass
    # Fallback: we hold the per-repo lock, so re-check absence then rename (rename onto an
    # empty directory would silently replace it, hence the explicit check).
    if os.path.lexists(target):
        raise Fail(4, "conflict", f"target appeared during promotion: {target}")
    os.rename(staging, target)
    fsync_dir(root)
    return "rename-fallback"


def run(args, out):
    allowed = {s.strip() for s in os.environ.get("REQUEST_REPO_ALLOW_SCHEMES", "file").split(",") if s.strip()}
    rid = args.repository_id
    if not ID_RE.match(rid) or ".." in rid:
        raise Fail(2, "invalid", f"invalid repository id {rid!r}")
    source = normalize_source(args.source, allowed)
    out["source"] = source
    root = os.path.realpath(os.environ.get("WORKSPACE_ROOT", "/workspace"))
    target = os.path.join(root, rid)
    out["path"] = target
    meta = os.path.join(root, ".herdr-repos")
    locks, staging_dir, state_dir = (os.path.join(meta, d) for d in ("locks", "staging", "state"))
    try:
        for d in (locks, staging_dir, state_dir):
            os.makedirs(d, exist_ok=True)
        if os.stat(staging_dir).st_dev != os.stat(root).st_dev:
            raise Fail(7, "error", "staging and target parent are on different filesystems")
    except OSError as e:
        raise Fail(7, "error", f"workspace not usable: {e}")

    os.environ["GIT_CEILING_DIRECTORIES"] = root
    fd, out["waited"] = acquire_lock(os.path.join(locks, rid + ".lock"), args.timeout)
    try:
        state_path = os.path.join(state_dir, rid + ".json")
        state = read_state(state_path) or {}
        attempts = int(state.get("attempts", 0))
        out["attempt"] = attempts
        base = {"repository_id": rid, "source": source, "git_version": out["git_version"]}

        if os.path.lexists(target):
            if not os.path.isdir(target) or os.path.islink(target) or not valid_repo(target):
                raise Fail(4, "conflict", f"{target} exists and is not a valid repository root")
            head, sh, pr = repo_info(target)
            out.update(head=head, shallow=sh, partial=pr)
            if state.get("status") == "ready":
                if state.get("source") != source:
                    raise Fail(3, "source-mismatch",
                               f"ready with source {state.get('source')!r}, requested {source!r}")
                out.update(status="ready", action="already_ready", promotion=state.get("promotion"))
                return
            if origin_url(target) != source:
                raise Fail(4, "conflict", f"{target} is a repo with a different origin ({origin_url(target)!r})")
            write_json_atomic(state_path, dict(base, status="ready", recovered=True, attempts=attempts,
                                               head=head, promotion=None, updated=time.time()))
            out.update(status="ready", action="recovered", promotion=None)
            return

        # Target absent: we hold the lock, so any staging/<id>@* is stale.
        for name in os.listdir(staging_dir):
            if name.startswith(rid + "@"):
                log(f"removing stale staging {name}")
                shutil.rmtree(os.path.join(staging_dir, name), ignore_errors=True)
        attempts += 1
        out["attempt"] = attempts
        stg = os.path.join(staging_dir, f"{rid}@{os.getpid()}.{random.randrange(16**6):06x}")
        cmd = ["clone", "--quiet"]
        if args.depth:
            cmd += ["--depth", str(args.depth)]
        if args.filter:
            cmd += ["--filter", args.filter]
        if args.branch:
            cmd += ["--branch", args.branch]
        cmd += ["--", source, stg]
        log(f"cloning {source} into {stg} (attempt {attempts})")
        err = None
        try:
            # PR_SET_PDEATHSIG: if this process is SIGKILLed mid-clone, the kernel kills git too,
            # so no orphaned clone keeps writing into a staging dir the next lock holder removes.
            r = subprocess.run(["git"] + cmd, env=dict(os.environ, GIT_TERMINAL_PROMPT="0"),
                               capture_output=True, text=True, timeout=args.timeout,
                               preexec_fn=die_with_parent)
            if r.returncode != 0:
                err = r.stderr.strip()[-2000:] or f"git clone exited {r.returncode}"
        except subprocess.TimeoutExpired:
            err = f"git clone timed out after {args.timeout}s"
        if err is not None:
            shutil.rmtree(stg, ignore_errors=True)
            write_json_atomic(state_path, dict(base, status="failed", attempts=attempts,
                                               error=err, updated=time.time()))
            raise Fail(5, "failed", err)

        pause = float(os.environ.get("REQUEST_REPO_TEST_PAUSE_AFTER_CLONE", "0") or 0)
        if pause:
            log(f"TEST-ONLY pause {pause}s before promotion")
            time.sleep(pause)
        promotion = promote(stg, target, root)
        head, sh, pr = repo_info(target)
        write_json_atomic(state_path, dict(base, status="ready", attempts=attempts, head=head,
                                           promotion=promotion, updated=time.time()))
        out.update(status="ready", action="hydrated", head=head, shallow=sh, partial=pr, promotion=promotion)
    finally:
        os.close(fd)


def main():
    p = argparse.ArgumentParser(prog="request-repo")
    p.add_argument("--timeout", type=float, default=float(os.environ.get("REQUEST_REPO_TIMEOUT", "600")))
    p.add_argument("--depth", type=int)
    p.add_argument("--filter")
    p.add_argument("--branch")
    p.add_argument("repository_id")
    p.add_argument("source")
    try:
        args = p.parse_args()
    except SystemExit as e:
        sys.exit(2 if e.code else 0)
    t0 = time.monotonic()
    out = dict(repository_id=args.repository_id, path=None, status=None, action=None, source=args.source,
               head=None, shallow=None, partial=None, git_version=None, duration_ms=None, waited=False,
               attempt=None, promotion=None, error=None)
    code = 0
    try:
        try:
            v = git(["--version"]).stdout.strip()
            out["git_version"] = v.replace("git version ", "")
        except OSError as e:
            raise Fail(7, "error", f"git not runnable: {e}")
        run(args, out)
    except Fail as f:
        code, out["status"], out["error"] = f.code, f.status, f.msg
        log(f.msg)
    except Exception as e:  # unexpected: environment error
        code, out["status"], out["error"] = 7, "error", f"{type(e).__name__}: {e}"
        log(out["error"])
    out["duration_ms"] = int((time.monotonic() - t0) * 1000)
    print(json.dumps(out, sort_keys=True))
    sys.exit(code)


if __name__ == "__main__":
    main()
