# EXP-006 stage 2 execution image: tmux + non-root sshd + the synthetic counter.
# PROPOSED for owner review; not built, not pushed, not run. See ../k8s/RUNBOOK.md.
#
# Same base digest as the EXP-002 image. Debian packages are pinned to exact binary
# versions read from the live amd64 Packages indexes on 2026-11-22 (UTC); the indexes
# were the trixie 13.8 Release of 2026-11-21 09:15 UTC and trixie-security of
# 2026-11-21 00:53 UTC:
#   tmux            3.5a-3                  suite trixie
#   openssh-server  1:10.0p1-7+deb13u4      suite trixie (trixie-security still lists
#                                           the older +deb13u2, so apt picks trixie)
#   tini            0.19.0-3+b8             suite trixie (binNMU +b8, not 0.19.0-3)
#   procps          2:4.0.4-9               suite trixie
#   trixie-updates carries none of these four.
# Sources:
#   https://deb.debian.org/debian/dists/trixie/main/binary-amd64/Packages.xz
#   https://deb.debian.org/debian/dists/trixie-updates/main/binary-amd64/Packages.xz
#   https://security.debian.org/debian-security/dists/trixie-security/main/binary-amd64/Packages.xz
# The base image digest is a fixed snapshot, but `apt-get update` reads the LIVE
# archive, so the live index is what matters. A pin goes stale when a point release,
# security update or binNMU replaces it. A stale pin fails the build: re-verify the
# pin and re-review; do not float to latest. The RUN below prints `apt-cache policy`
# first, so a mismatch is diagnosable from the CI log. openssh-server pulls
# openssh-client and openssh-sftp-server at the same version.
ARG BASE_IMAGE=docker.io/library/debian:trixie-slim@sha256:7378260c0a098d27ac206225db5e7d92b8c7c84ea7afccc86eeb513756bbd392

FROM ${BASE_IMAGE}
ARG TMUX_VERSION=3.5a-3
ARG OPENSSH_VERSION=1:10.0p1-7+deb13u4
ARG TINI_VERSION=0.19.0-3+b8
ARG PROCPS_VERSION=2:4.0.4-9

# tini: PID 1 that reaps the daemonized tmux server and forwards SIGTERM to sshd.
# procps: ps/pgrep for evidence capture inside the pod.
# Host keys generated by the package postinst are removed: every pod uses the
# per-run key from the Secret. /run/sshd is created root-owned (privilege
# separation directory; may be unused when sshd is not root, see RUNBOOK risks).
RUN apt-get update \
 && apt-cache policy tini tmux openssh-server procps \
 && apt-get install -y --no-install-recommends \
      "tmux=${TMUX_VERSION}" \
      "openssh-server=${OPENSSH_VERSION}" \
      "tini=${TINI_VERSION}" \
      "procps=${PROCPS_VERSION}" \
 && rm -rf /var/lib/apt/lists/* \
 && rm -f /etc/ssh/ssh_host_* \
 && mkdir -p /run/sshd \
 && chmod 0755 /run/sshd

# Non-root runtime user. The '*' password field (not '!') keeps sshd from
# treating the account as locked when UsePAM is off; password login is disabled
# separately in sshd_config.
# Home is /tmp/home (created 0700 by the entrypoint on the /tmp emptyDir): sshd's
# StrictModes walk of AuthorizedKeysFile stops at the home directory, so the
# world-writable /tmp above it is never checked.
RUN groupadd -g 1000 herdr \
 && useradd -u 1000 -g 1000 -d /tmp/home -s /bin/bash -M -p '*' herdr \
 && { dpkg-query -W -f='deb ${Package}=${Version}\n' tmux openssh-server tini procps; } >/usr/share/exp006-manifest.txt

COPY counter.sh /usr/local/bin/counter.sh
COPY entrypoint.sh /usr/local/bin/exp006-entrypoint
RUN chmod 0755 /usr/local/bin/counter.sh /usr/local/bin/exp006-entrypoint \
 && tmux -V && ssh -V

LABEL org.opencontainers.image.source="https://github.com/jlaska/herdrnetes" \
      org.opencontainers.image.description="EXP-006 execution image: tmux + non-root sshd + counter (experiment, not production)"

USER 1000:1000
EXPOSE 2222
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/exp006-entrypoint"]
